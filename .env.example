TG__BOT_TOKEN=<bot token>

# SQLite must be on a local persistent filesystem; create the directory first.
# Docker Compose overrides this path with its shared persistent volume.
DB__PATH=./data/price-alert-bot.sqlite3
DB__BUSY_TIMEOUT_SECONDS=30
DB__ECHO=False
DB__AUTOFLUSH=False
DB__EXPIRE_ON_COMMIT=False

REDIS__HOST=<redis host>
REDIS__PORT=6379
REDIS__DB=0
# Optional: unset (or omit) means no password, which is the common case for
# local development and the docker-compose Redis service from PAB-036.
# REDIS__PASSWORD=<redis password>

APP__SCHEDULER_INTERVAL_SECONDS=900
APP__ALERT_COOLDOWN_SECONDS=86400
APP__MAX_PRODUCTS_PER_USER=50
APP__MARKETPLACE_CONCURRENCY=5
APP__HTTP_TIMEOUT_SECONDS=10.0
# IANA timezone for the "price as of HH:MM" labels shown to users (PAB-100).
APP__DISPLAY_TIMEZONE=Europe/Moscow

# Wildberries antibot token, obtained through a headless Chromium (PAB-079).
WB__TOKEN_TIMEOUT_SECONDS=30
WB__FAILURE_PAUSE_SECONDS=300
WB__LAUNCH_BUDGET=8
WB__LAUNCH_WINDOW_SECONDS=900
# Chromium sandbox: keep false where unprivileged user namespaces are restricted.
WB__BROWSER_SANDBOX=false

# Ozon anti-bot cookies, obtained through a headless Chromium (PAB-110).
# The browser is shared with WB: only one runs at a time.
# Outbound SOCKS5 proxy for Ozon only (PAB-111): browser and price requests
# share one exit; DNS goes through the proxy. Empty means no proxy.
# Format: socks5h://<login>:<password>@<host>:<port> (socks5:// is accepted too;
# login and password come together, percent-encode special characters).
OZON__PROXY_URL=
OZON__TOKEN_TIMEOUT_SECONDS=30
OZON__FAILURE_PAUSE_SECONDS=300
OZON__LAUNCH_BUDGET=8
OZON__LAUNCH_WINDOW_SECONDS=900
# Chromium sandbox: keep false where unprivileged user namespaces are restricted.
OZON__BROWSER_SANDBOX=false
