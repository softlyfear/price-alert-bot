#!/usr/bin/env bash
# pre-commit stashes unindexed changes at pre-push, risking other agents' work.
# Validate pushed commits in temporary worktrees without modifying the current one.
# A zero local SHA deletes a ref; a new remote ref still requires validation.

set -euo pipefail

ZERO_SHA="0000000000000000000000000000000000000000"
REPO_ROOT="$(git rev-parse --show-toplevel)"
VENV_PYTHON="$REPO_ROOT/.venv/bin/python"
VENV_LINT_IMPORTS="$REPO_ROOT/.venv/bin/lint-imports"

declare -a TMP_WORKTREES=()

cleanup() {
    local dir
    for dir in ${TMP_WORKTREES[@]+"${TMP_WORKTREES[@]}"}; do
        git -C "$REPO_ROOT" worktree remove --force "$dir" >/dev/null 2>&1 || true
        rm -rf "$dir"
    done
}
# Signal traps must exit explicitly; EXIT then runs cleanup once.
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

declare -A seen=()
shas=()
while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    [ "$local_sha" = "$ZERO_SHA" ] && continue
    if [ -z "${seen[$local_sha]+x}" ]; then
        seen[$local_sha]=1
        shas+=("$local_sha")
    fi
done

if [ "${#shas[@]}" -eq 0 ]; then
    exit 0
fi

status=0
for sha in "${shas[@]}"; do
    tmpdir="$(mktemp -d)"
    TMP_WORKTREES+=("$tmpdir")

    if ! git -C "$REPO_ROOT" worktree add --detach --quiet "$tmpdir" "$sha" >/dev/null 2>&1; then
        echo "pre-push: failed to check out $sha for validation" >&2
        status=1
        continue
    fi

    if ! ( cd "$tmpdir" && "$VENV_PYTHON" -m mypy app tests ) \
       || ! ( cd "$tmpdir" && "$VENV_LINT_IMPORTS" ); then
        echo "pre-push: commit $sha failed mypy/lint-imports, push rejected" >&2
        status=1
    fi
done

exit "$status"
